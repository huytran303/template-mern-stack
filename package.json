{
  "name": "template-mern-stack",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client & wait",
    "test": "npm test --workspace=server",
    "seed": "npm run seed --workspace=server",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "bash scripts/lint.sh",
    "check": "bash scripts/check-constitution.sh && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.66.0"
  }
}
